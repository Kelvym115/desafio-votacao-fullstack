# Exemplo para uso manual com --env-file. start.sh gera /opt/votacao-state/.env.
# DNS deve apontar este subdomínio para o servidor antes de iniciar o Caddy.
DOMAIN=pautas.seu-dominio.com

# Obrigatória: gere uma senha exclusiva, por exemplo com `openssl rand -hex 32`.
# Não versione a senha nem publique a saída de `docker compose config`.
POSTGRES_PASSWORD=
